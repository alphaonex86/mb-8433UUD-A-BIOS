diff --git a/src/arch/486/gdt_init.S b/src/arch/486/gdt_init.S
index 456084fde741a48b29ab921a5366a84139d0a94b..9f73a304df082ae07227732af9889cf76f29cd7c 100644
--- a/src/arch/486/gdt_init.S
+++ b/src/arch/486/gdt_init.S
@@ -1,11 +1,24 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+/*
+ * The "ROM" GDT used from the reset vector until ramstage (c_start.S then
+ * loads a larger GDT in RAM). It is linked into three stages:
+ *  - bootblock: entry16.S loads gdtptr directly with lgdtl (gdt_init()
+ *    itself is unreferenced and dropped by the linker);
+ *  - romstage (assembly_entry.S) and postcar (arch/486/exit_car.S) call
+ *    gdt_init() so that GDTR points to their own copy of the table.
+ * Selectors: 0x08 flat 32-bit code, 0x10 flat 32-bit data
+ * (arch/rom_segs.h). program.ld and bootblock.ld put .init first.
+ */
+
 .code32
 
 .section .init, "ax", @progbits
 
 .section .init._gdt_, "ax", @progbits
 
+	/* void gdt_init(void): GDTR := gdtptr (6 bytes: 16-bit limit,
+	 * 32-bit linear base). */
 	.globl gdt_init
 gdt_init:
 /*
@@ -48,9 +61,18 @@ gdtptr64:
 	.quad	gdt		 /* we know the offset */
 #endif
 
+	/* Each descriptor is 8 bytes: limit[15:0], base[15:0], base[23:16],
+	 * access byte, flags (G, D/B, L, AVL) in the high nibble with
+	 * limit[19:16] in the low nibble, base[31:24].
+	 * Access 0x9b = present, ring 0, code, execute/read, accessed;
+	 * 0x93 = present, ring 0, data, read/write, accessed.
+	 * Flags 0xc = G (limit in 4 KiB units) + D (32-bit): base 0 with limit
+	 * 0xfffff * 4 KiB covers the whole 4 GiB, so offset = physical
+	 * address ("flat"). */
 	.align	4
 gdt:
 	/* selgdt 0, unused */
+	/* (selector 0 is the null selector; the CPU never reads entry 0) */
 	.word	0x0000, 0x0000		/* dummy */
 	.byte	0x00, 0x00, 0x00, 0x00
 
@@ -66,6 +88,7 @@ gdt:
 	//TODO only 64bit??
 
 	/* selgdt 0x18, flat code segment (64-bit) */
+	/* (flags 0xa = G + L: x86-64 only, never loaded on a 486) */
 	.word   0xffff, 0x0000
 	.byte   0x00, 0x9b, 0xaf, 0x00
 
diff --git a/src/arch/486/id.S b/src/arch/486/id.S
index 64f7a799b0af337b1c8fcc0ed722fcd1d010d8ec..e5179e94792474f6c926547262eecf7a6f77ab2e 100644
--- a/src/arch/486/id.S
+++ b/src/arch/486/id.S
@@ -1,5 +1,15 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+/*
+ * ROM identification block (data only, bootblock). bootblock.ld places the
+ * .id section so that it ends at 0xFFFFFFF0, right below the reset vector.
+ * Tools such as flashrom read it from the top of the image to identify the
+ * board: three NUL-terminated strings, then for each string its address as
+ * a negative offset from 4 GiB (0x100000000 - address, i.e. its distance
+ * from the end of the address space), then the ROM size.
+ * COREBOOT_VERSION comes from the generated build.h.
+ */
+
 #include <build.h>
 
 .section ".id", "a", @progbits
diff --git a/src/arch/486/idt.S b/src/arch/486/idt.S
index 99d6e95ec55951d735587a39eae94d1c4c118228..111dba8ce0f487be658dd1017eff598a0437912f 100644
--- a/src/arch/486/idt.S
+++ b/src/arch/486/idt.S
@@ -1,5 +1,20 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+/*
+ * CPU exception entry stubs for ramstage (CONFIG_IDT_IN_EVERY_STAGE is off,
+ * so earlier stages run with the empty IDT from entry16.S).
+ * exception_init() in exception.c builds a 20-entry IDT of interrupt gates
+ * pointing to vec0..vec19 and loads it with lidt. On an exception the CPU
+ * pushes EFLAGS, CS, EIP (no stack switch: everything runs in ring 0) and,
+ * for vectors 8, 10-14 and 17 only, an error code. Each stub pushes a dummy
+ * error code where the CPU does not, then the vector number, so that the
+ * frame always has the same layout, and jumps to int_hand.
+ * int_hand saves the registers as a struct eregs and calls the C function
+ * x86_exception(struct eregs *): it dumps the registers and halts, except
+ * for debug-register breakpoints (vector 1, see breakpoint.c and
+ * null_breakpoint.c), which return here and resume with iret.
+ */
+
 	.section ".text._idt", "ax", @progbits
 #if ENV_X86_64
 	.code64
@@ -179,11 +194,16 @@ int_hand:
 	 * 12(%esp) cs
 	 * 16(%esp) eflags
 	 */
+	/* Build struct eregs (arch/486/include/arch/registers.h) downwards:
+	 * after these 8 pushes the stack holds, from ESP upwards, eax ecx edx
+	 * ebx esp ebp esi edi vector error_code eip cs eflags. */
 	pushl	%edi
 	pushl	%esi
 	pushl	%ebp
 
 	/* Original stack pointer */
+	/* (32 = 3 pushes above + vector, error code, eip, cs, eflags: the
+	 * ESP value before the exception) */
 	leal	32(%esp), %ebp
 	pushl	%ebp
 	pushl	%ebx
@@ -200,6 +220,8 @@ int_hand:
 	sub	$12, %esp
 	pushl	%ebp	/* Pointer to structure on the stack */
 	call	x86_exception
+	/* The argument slot still holds the eregs pointer: popping it into
+	 * ESP undoes both the argument push and the alignment. */
 	pop	%esp	/* Unwind the stack alignment and argument passing. */
 
 	popl	%eax
@@ -212,5 +234,7 @@ int_hand:
 	popl	%edi
 
 	addl	$8, %esp /* pop of the vector and error code */
+	/* iret pops EIP, CS, EFLAGS: resume the interrupted code (with the
+	 * register values x86_exception may have changed in eregs). */
 	iret
 #endif
diff --git a/src/arch/486/include/arch/pirq_routing.h b/src/arch/486/include/arch/pirq_routing.h
