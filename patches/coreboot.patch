+ * then the per-stage .bss, end of CAR 0x1A2000. The stack grows down from
+ * _ecar_stack towards _car_region_start.
+ */
 . = CONFIG_DCACHE_RAM_BASE;
 .car.data . (NOLOAD) : {
 	_car_region_start = . ;
@@ -87,6 +97,8 @@
