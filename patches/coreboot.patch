diff --git a/src/arch/486/bootblock.ld b/src/arch/486/bootblock.ld
index 1126c84b9b15c6e492d96ad0f85e84f0eaab1150..b2df67a25aea22f1aa3f5b29f6e63c19e262a56e 100644
--- a/src/arch/486/bootblock.ld
+++ b/src/arch/486/bootblock.ld
@@ -1,5 +1,20 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
+/*
+ * Layout of the bootblock at the top of the 4 GiB address space, which the
+ * chipset maps to the top of the flash. Included at the end of
+ * memlayout.ld (C-preprocessed, CONFIG() and #if work here). From the top:
+ *   0xFFFFFFFC  .header_pointer  CBFS master header pointer (4 bytes)
+ *   0xFFFFFFF0  .reset           reset vector jump (reset16.S), zero padded
+ *   below       .id              board identification strings (id.S)
+ *   below       .init            assembly: entry16.S first (.init._start),
+ *                                then the ROM GDT, cache_as_ram.S, entry32.S
+ *   below       .text etc.       bootblock C code (program.ld)
+ * The 16-bit code in entry16.S cannot compute 32-bit addresses, so the
+ * linker provides the low 16 bits of the descriptor-table images as
+ * gdtptr_offset and nullidt_offset (see entry16.S).
+ */
+
 gdtptr_offset = gdtptr & 0xffff;
 nullidt_offset = nullidt & 0xffff;
 
@@ -31,6 +46,9 @@ SECTIONS {
 	 */
 	PROGRAM_SZ = SIZEOF(.text) + 512;
 
+	/* The sizes used here (PROGRAM_SZ, EARLYASM_SZ, _ID_SECTION) are
+	 * defined further down from SIZEOF(); ld resolves the forward
+	 * references. ECFW and FIT pointers are empty on this board. */
 	. = MIN(_ECFW_PTR, MIN(_ID_SECTION, _FIT_POINTER)) - EARLYASM_SZ;
 	. = CONFIG(SIPI_VECTOR_IN_ROM) ? ALIGN(4096) : ALIGN(16);
 	BOOTBLOCK_TOP = .;
@@ -86,6 +104,7 @@ SECTIONS {
 	. = 0xfffffff0;
 #endif
 	_X86_RESET_VECTOR = .;
+	/* The 5-byte jump of reset16.S, then zeros up to the header pointer. */
 	.reset . : {
 		*(.reset);
 		. = _X86_RESET_VECTOR_FILLING;
diff --git a/src/arch/486/c_start.S b/src/arch/486/c_start.S
index 3409a5d17ae4b026da2f8de47d589bd04dad75a1..5ebe85ecaaf39696c66d610868a4ecfac5f0482d 100644
--- a/src/arch/486/c_start.S
+++ b/src/arch/486/c_start.S
@@ -3,6 +3,15 @@
 #include <cpu/486/post_code.h>
 #include <arch/ram_segs.h>
 
+/*
+ * Ramstage entry point and the ramstage GDT.
+ * Postcar loads ramstage from CBFS into RAM (cbmem), relocates it (it is an
+ * rmodule) and calls _start(cbmem_top) as a C function: 32-bit flat
+ * protected mode, caches on, interrupts off, still on the postcar stack.
+ * _start switches to its own GDT and stack and calls main()
+ * (lib/hardwaremain.c), which never returns.
+ */
+
 /* Place the stack in the bss section. It's not necessary to define it in
  * the linker script. */
 	.section .bss, "aw", @nobits
@@ -10,6 +19,7 @@
 .global _estack
 .global _stack_size
 
+/* CONFIG_STACK_SIZE (8 KiB) of ramstage stack, in RAM. */
 .align 16
 _stack:
 .space CONFIG_STACK_SIZE
@@ -25,6 +35,10 @@ _estack:
 	.globl _start
 _start:
 	cli
+	/* GDTR := the GDT below (in .data, so in RAM). The far jump reloads
+	 * CS with RAM_CODE_SEG = 0x10, the flat code segment of this table:
+	 * the selector numbers differ from the ROM GDT (code 0x08, data 0x10).
+	 * Then DS/ES/SS := RAM_DATA_SEG = 0x18, FS/GS := null selector. */
 #if ENV_X86_64
 	movabs	$gdtaddr, %rax
 	lgdt	(%rax)
@@ -54,6 +68,7 @@ _start:
 	movabs	$_stack, %rdi
 #else
 	/* The return argument is at 0(%esp), the calling argument at 4(%esp) */
+	/* (_cbmem_top_ptr: read back by cbmem_top() in lib/imd_cbmem.c) */
 	movl	4(%esp), %eax
 	movl	%eax, _cbmem_top_ptr
 	leal	_stack, %edi
@@ -64,6 +79,7 @@ _start:
 	 * recently uncovered a bug in the broadcast SIPI
 	 * code.
 	 */
+	/* rep stosl: store EAX to ECX dwords at ES:EDI (EDI = _stack). */
 	movl	$_estack, %ecx
 	subl	%edi, %ecx
 	shrl	$2, %ecx   /* it is 32 bit aligned, right? */
@@ -92,6 +108,9 @@ _start:
 	call gdb_hw_init
 	call gdb_stub_breakpoint
 #endif
+	/* lib/hardwaremain.c: loads the IDT (exception_init), enumerates
+	 * and configures the devices, writes the tables, loads and starts
+	 * the payload (SeaBIOS). */
 	call	main
 	/* NOTREACHED */
 .Lhlt:
@@ -146,6 +165,9 @@ gdtaddr:
 	 * stuff, like initializing PCI option ROMs in real mode, or doing
 	 * a resume from a suspend to RAM.
 	 */
+	/* Descriptor format: see gdt_init.S. In this build only 0x10, 0x18
+	 * and the per-CPU entry are used: option ROMs run under SeaBIOS, not
+	 * coreboot, and ACPI S3 resume is not built. */
 gdt:
 	/* selgdt 0, unused */
 	.word	0x0000, 0x0000		/* dummy */
@@ -175,6 +197,7 @@ gdt:
 
 	/* The next two entries are used for executing VGA option ROMs */
 
+	/* (flags 0: byte granularity, 16-bit; limit 0xffff) */
 	/* selgdt 0x28 16 bit 64k code at 0x00000000 */
 	.word	0xffff, 0x0000
 	.byte	0, 0x9a, 0, 0
@@ -184,6 +207,9 @@ gdt:
 	.byte	0, 0x92, 0, 0
 
 	/* The next two entries are used for ACPI S3 RESUME */
+	/* (Unused here. arch/ram_segs.h names 0x38 code and 0x40 data, the
+	 * reverse of the comments below, and the limit[15:0] of 0x38 is 0,
+	 * so its limit is 0xF0000FFF rather than 4 GiB; both as upstream.) */
 
 	/* selgdt 0x38, flat data segment 16 bit */
 	.word	0x0000, 0x0000		/* dummy */
@@ -202,6 +228,9 @@ gdt:
 	.word	0xffff, 0x0000
 	.byte	0x00, 0x9b, 0xaf, 0x00
 #endif
+	/* One data descriptor per CPU (CONFIG_MAX_CPUS = 1 here).
+	 * set_cpu_info() in arch/486/cpu.c patches its base to the CPU data
+	 * and loads it into GS; cpu_info() then reads the pointer at gs:0. */
 per_cpu_segment_descriptors:
 	.rept CONFIG_MAX_CPUS
 	/* flat data segment */
