+    [NB_IDE_32BIT] = 1, [NB_ISAPNP] = 1, [NB_IDE_PRIMARY] = 1, [NB_IDE_SECONDARY] = 1, [NB_FDC] = 1,
+    [NB_COM1] = 1, [NB_COM2] = 2, [NB_LPT] = 1,
