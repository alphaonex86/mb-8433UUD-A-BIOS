+
+static int
+usb_listed_add(void *key, int parent)
+{
+    if (UsbListedCount >= USB_LISTED_MAX)
+        return -1;
+    struct usb_listed *l = &UsbListed[UsbListedCount];
+    memset(l, 0, sizeof(*l));
+    l->key = key;
+    l->parent = parent;
+    return UsbListedCount++;
