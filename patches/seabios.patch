+    char roms[64] = "", *p = roms;
+    for (a = 0xc8000; a < 0xe0000; a += 2048) {
+        u8 *rom = (void*)a;
+        if (rom[0] == 0x55 && rom[1] == 0xaa && rom[2] && p < roms + sizeof(roms) - 12) {
+            p += snprintf(p, roms + sizeof(roms) - p, " %x (%dK)", a, rom[2] / 2);
