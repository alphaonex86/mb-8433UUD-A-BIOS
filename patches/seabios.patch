+        { 0x0600, "Host bridge" }, { 0x0601, "ISA bridge" }, { 0x0604, "PCI bridge" },
+        { 0x0680, "Bridge" }, { 0x0700, "Serial" }, { 0x0701, "Parallel" }, { 0x0c03, "USB" },
+    };
+    int i;
+    for (i = 0; i < ARRAY_SIZE(t); i++)
