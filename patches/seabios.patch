+        return;
+    }
+    values_load();
+    for (;;) {
+        menu_draw(sel);
+        int key = get_keystroke(1000), n = ARRAY_SIZE(Menu);
+        switch (key) {
+        case 0x48: sel = (sel + n - 1) % n; break;
