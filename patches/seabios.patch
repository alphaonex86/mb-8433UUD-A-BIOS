+{
+    u16 size;
+    if (!CONFIG_PNPBIOS)
+        return;
+    PnpCsns = csns;
+    PnpReadPort = csns ? readport : 0;
+    FlashChip = fl_detect();
+    if (!escd_start())
+        return;
+    card_end();
+    escd_board(board);
+    size = escd_check(0);
+    *(u16 *)Escd = EscdLen + 2;
+    put16(escd_sum(0, 0, EscdLen + 2));
+    if (size != EscdLen || !escd_same(0, 0, 0, 0, size)) {
+        u16 ret = escd_write(0, 0, 0, EscdLen);
+        dprintf(1, "ESCD written: %x (flash chip %d)\n", ret, FlashChip);
