+    switch (reg) {
+        case 1:
+            return rtl8169_link_up(s) ? 0x796d : 0x7949; /* link, autonegotiation complete */
+        case 5:
+            return rtl8169_link_up(s) ? 0x41e1 : 0;
+        case 10:
+            return rtl8169_link_up(s) ? 0x3c00 : 0;
+        default:
+            return s->phy[reg];
+    }
