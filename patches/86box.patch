+        rtl8169_reset_phy(s);
+    else if (reg == 0)
+        s->phy[0] = val & ~0x0200; /* autonegotiation restart completes at once */
+    else if (reg != 2 && reg != 3 && reg != 15) /* PHY ID, extended status */
+        s->phy[reg] = val;
