+/* Gigabit PHY with autonegotiation always complete against a 10/100/1000 full and half duplex partner. */
+static uint16_t
+rtl8169_phy_read(RTL8139State *s, int reg)
+{
+    if (s->phy[31] && reg != 31)
+        return 0; /* vendor pages */
