+{
+    static const uint8_t ext[][2] = { { WIN_READ_EXT, WIN_READ }, { WIN_WRITE_EXT, WIN_WRITE },
+                                      { WIN_VERIFY_EXT, WIN_VERIFY },
+                                      { WIN_READ_MULTIPLE_EXT, WIN_READ_MULTIPLE },
+                                      { WIN_WRITE_MULTIPLE_EXT, WIN_WRITE_MULTIPLE } };
+    int i = 0;
+    ide->ext_left = 0;
+    while ((i < 5) && (ext[i][0] != *cmd))
+        i++;
