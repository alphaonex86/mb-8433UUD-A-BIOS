#!/bin/sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo "LINUX-TEST: $(uname -r) on $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2)"
grep MemTotal /proc/meminfo
cat /proc/partitions
ls /sys/class/net
echo LINUX-TEST-OK
# test/flashlinux.sh: rewrite the BIOS flash with tools/flashbios and images fetched by TFTP
if grep -q flashtest /proc/cmdline; then
  mkdir -p /tmp /dev && mount -t devtmpfs devtmpfs /dev && cd /tmp
  for f in flashbios bad.rom a.rom b.rom b2.rom; do tftp -g -r $f 10.0.2.2 || echo "FLASHTEST: no $f"; done
  chmod +x flashbios
  ./flashbios -n bad.rom; echo "FLASHTEST-BAD-RC=$?"
  ./flashbios -n b.rom && ./flashbios b.rom && ./flashbios a.rom && ./flashbios b2.rom; echo "FLASHTEST-RC=$?"
fi
exec sh
