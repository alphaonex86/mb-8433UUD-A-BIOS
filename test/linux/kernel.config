# Minimal i486 test kernel (allnoconfig + this): consoles, PCI, RTL8139, IDE, APM, initramfs.
CONFIG_M486=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EXPERT=y
CONFIG_EARLY_PRINTK=y
CONFIG_FUTEX=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="earlyprintk=serial,ttyS0,115200 console=tty0 console=ttyS0,115200 panic=10"
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_PCI=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_APM=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139TOO=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_LEGACY=y
