# Appended to the board's config_seabios (last assignment wins): Award 4.51PG feature set + setup menu.
CONFIG_SETUP_MENU=y
# PIO like the original BIOS: many drives of the era have no DMA and SeaBIOS does not check for it.
# CONFIG_ATA_DMA is not set
# Runtime data in conventional memory so the shadow areas can be write-protected after POST, like the
# original BIOS (the UMC write protection is global): ISA ROM cards with RAM in their window then work.
# CONFIG_MALLOC_UPPERMEMORY is not set
# Settings come from the setup utility (CMOS), not from CBFS files.
# CONFIG_COREBOOT_FLASH is not set
# CONFIG_AHCI is not set
# USB 1 and 2 host controllers on a PCI card: keyboard and boot from USB storage (86Box has no USB devices).
CONFIG_USB=y
CONFIG_USB_UHCI=y
CONFIG_USB_OHCI=y
CONFIG_USB_EHCI=y
# CONFIG_USB_XHCI is not set
CONFIG_USB_MSC=y
# CONFIG_USB_UAS is not set
CONFIG_USB_HUB=y
CONFIG_USB_KEYBOARD=y
# CONFIG_USB_MOUSE is not set
